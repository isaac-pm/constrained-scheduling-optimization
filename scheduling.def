Bootstrap: docker
From: python:3.11-slim

%labels
    Author System
    Software MiniZinc & Python
    Version 2.9.5
    OS Debian (Python 3.11-slim)

%files
    # Copy your local requirements into the container during the build
    requirements.txt /opt/requirements.txt

%post
    # 1. Update packages and install necessary tools
    apt-get update
    apt-get install -y wget tar ca-certificates
    rm -rf /var/lib/apt/lists/*

    # 2. Install MiniZinc 2.9.5
    MZ_VERSION="2.9.5"
    MZ_ARCHIVE="MiniZincIDE-${MZ_VERSION}-bundle-linux-x86_64.tgz"
    MZ_URL="https://github.com/MiniZinc/MiniZincIDE/releases/download/${MZ_VERSION}/${MZ_ARCHIVE}"
    
    cd /opt
    wget -q "${MZ_URL}"
    tar -xzf "${MZ_ARCHIVE}"
    rm "${MZ_ARCHIVE}"
    ln -s "/opt/MiniZincIDE-${MZ_VERSION}-bundle-linux-x86_64" /opt/minizinc

    # 3. Install OR-Tools (Using Debian 11/12 binaries to match python-slim)
    ORT_VERSION="9.11"
    ORT_REV="4210"
    ORT_ARCHIVE="or-tools_amd64_flatzinc_debian-11_v${ORT_VERSION}.${ORT_REV}.tar.gz"
    ORT_URL="https://github.com/google/or-tools/releases/download/v${ORT_VERSION}/${ORT_ARCHIVE}"

    wget -q "${ORT_URL}"
    tar -xzf "${ORT_ARCHIVE}"
    rm "${ORT_ARCHIVE}"
    
    # Create a clean symlink for OR-Tools
    ln -s "/opt/or-tools_flatzinc_debian-11_v${ORT_VERSION}.${ORT_REV}" /opt/ortools

    # 4. Wire OR-Tools into MiniZinc's global configuration
    # We place the .msc file directly inside MiniZinc's share directory so it is discovered automatically
    cat <<EOF > /opt/minizinc/share/minizinc/solvers/or-tools.msc
{
  "id": "cp-sat",
  "name": "OR-Tools",
  "description": "OR Tools CP-SAT Solver",
  "version": "${ORT_VERSION}.${ORT_REV}",
  "executable": "/opt/ortools/bin/fzn-or-tools",
  "tags": ["cp", "int"],
  "stdFlags": ["-a", "-n", "-s", "-v", "-p", "-f", "-t"],
  "supportsMzn": false,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
EOF

    # 5. Install Python dependencies
    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir -r /opt/requirements.txt

%environment
    # Ensure correct encoding for Python terminal output
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Ensure the MiniZinc binaries and bundled libraries are discoverable
    export PATH="/opt/minizinc/bin:${PATH}"
    export LD_LIBRARY_PATH="/opt/minizinc/lib:${LD_LIBRARY_PATH}"

%runscript
    # The default command executed when the container runs
    exec python run.py "$@"
