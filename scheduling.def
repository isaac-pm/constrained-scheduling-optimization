Bootstrap: docker
From: python:3.11-slim

%labels
    Author System
    Software MiniZinc, Python & OR-Tools
    Version 2.9.5
    OS Debian (Python 3.11-slim)

%files
    # Copy your local requirements into the container during the build
    requirements.txt /opt/requirements.txt

%post
    # 1. Update packages and install necessary tools
    apt-get update
    apt-get install -y wget tar ca-certificates \
        libgl1 libegl1 libglib2.0-0 \
        libfontconfig1 libfreetype6 \
        libx11-6 libxext6 libxrender1 \
        libxcb1 libxcb-render0 libxcb-shape0 libxcb-xfixes0 \
        libxkbcommon0 libdbus-1-3 \
        libgpg-error0
    rm -rf /var/lib/apt/lists/*

    # 2. Install MiniZinc 2.9.5
    MZ_VERSION="2.9.5"
    MZ_ARCHIVE="MiniZincIDE-${MZ_VERSION}-bundle-linux-x86_64.tgz"
    MZ_URL="https://github.com/MiniZinc/MiniZincIDE/releases/download/${MZ_VERSION}/${MZ_ARCHIVE}"
    
    cd /opt
    wget -q "${MZ_URL}"
    tar -xzf "${MZ_ARCHIVE}"
    rm "${MZ_ARCHIVE}"
    ln -s "/opt/MiniZincIDE-${MZ_VERSION}-bundle-linux-x86_64" /opt/minizinc

    # 3. Install OR-Tools 9.15.6755 (Debian 12 C++ binaries to match python:3.11-slim)
    ORT_VERSION="9.15"
    ORT_REV="6755"
    ORT_ARCHIVE="or-tools_amd64_debian-12_cpp_v${ORT_VERSION}.${ORT_REV}.tar.gz"
    ORT_URL="https://github.com/google/or-tools/releases/download/v${ORT_VERSION}/${ORT_ARCHIVE}"

    cd /opt
    wget -q "${ORT_URL}"
    
    # Create a clean directory and extract the archive into it
    mkdir -p /opt/ortools
    tar -xzf "${ORT_ARCHIVE}" -C /opt/ortools --strip-components=1
    rm "${ORT_ARCHIVE}"

    # 4. Wire OR-Tools into MiniZinc's global configuration
    cat <<EOF > /opt/minizinc/share/minizinc/solvers/or-tools.msc
{
  "id": "cp-sat",
  "name": "OR-Tools",
  "description": "OR Tools CP-SAT Solver",
  "version": "${ORT_VERSION}.${ORT_REV}",
  "executable": "/opt/ortools/bin/fzn-ortools",
  "tags": ["cp", "int"],
  "stdFlags": ["-a", "-n", "-s", "-v", "-p", "-f", "-t"],
  "supportsMzn": false,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
EOF

    # 5. Install Python dependencies
    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir -r /opt/requirements.txt

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Expose MiniZinc and OR-Tools binaries
    export PATH="/opt/minizinc/bin:/opt/ortools/bin:${PATH}"
    
    # Expose both MiniZinc and OR-Tools shared libraries so the C++ solver runs correctly
    export LD_LIBRARY_PATH="/opt/minizinc/lib:/opt/ortools/lib:${LD_LIBRARY_PATH}"

%runscript
    # The default command executed when the container runs
    exec python run.py "$@"
